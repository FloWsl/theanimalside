# Playwright MCP Configuration
PLAYWRIGHT_MCP_ENDPOINT=http://localhost:3001
MCP_TIMEOUT_SECONDS=30

# Audit Configuration
BASE_URL=http://localhost:3000
AUDIT_REPORT_DIR=./audit_reports
SCREENSHOT_DIR=./audit_reports/screenshots

# Performance Thresholds
MAX_LCP_MS=2500
MAX_FID_MS=100
MAX_CLS_SCORE=0.1

# Audit System Settings
LOG_LEVEL=INFO
PARALLEL_TESTS=3
RETRY_ATTEMPTS=2